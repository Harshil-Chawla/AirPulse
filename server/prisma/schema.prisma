generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum StationType {
  FIXED
  MOBILE
  DRONE
}

enum DataSource {
  CPCB
  OPENAQ
  OPEN_METEO
  SIMULATED
}

model Station {
  id        Int         @id @default(autoincrement())
  name      String
  type      StationType
  city      String
  latitude  Float
  longitude Float

  readings Reading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reading {
  id Int @id @default(autoincrement())

  stationId Int
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  pm25 Float?
  pm10 Float?
  no2  Float?
  so2  Float?
  co   Float?
  o3   Float?
  aqi  Int?

  latitude  Float
  longitude Float

  source     DataSource
  recordedAt DateTime   @default(now())
  createdAt  DateTime   @default(now())

  @@index([stationId, recordedAt])
  @@index([recordedAt])
}
